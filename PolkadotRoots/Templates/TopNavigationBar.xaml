<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PolkadotRoots.Templates.TopNavigationBar">
    <x:Double x:Key="TopNavigationBarHeight">45</x:Double>

    <ControlTemplate x:Key="TopNavigationBarTemplate">
        <AbsoluteLayout AbsoluteLayout.LayoutBounds="0.5, 0.5, 1, 1"
                        AbsoluteLayout.LayoutFlags="All">

            <AbsoluteLayout AbsoluteLayout.LayoutBounds="0, 0, 45, 45"
                >
                <Image AbsoluteLayout.LayoutBounds="0.5, 0.5, 25, 25"
                    AbsoluteLayout.LayoutFlags="PositionProportional">
                    <Image.Source>
                        <FontImageSource Glyph="&#xf053;"
                                         FontFamily="FontAwesome"
                                         Color="{AppThemeBinding Light=Black, Dark=White}"
                                         Size="25"/>
                    </Image.Source>
                </Image>

                
                <AbsoluteLayout.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding BackCommand}" />

                </AbsoluteLayout.GestureRecognizers>

            </AbsoluteLayout>

            <Label AbsoluteLayout.LayoutBounds="0, 0.5, AutoSize, AutoSize"
                    AbsoluteLayout.LayoutFlags="PositionProportional"
                    HorizontalTextAlignment="Start"
                    VerticalTextAlignment="Center"
                   Margin="50,0,50,0"
                   >
                <Label.FormattedText>
                    <FormattedString>
                        <Span FontAttributes="Bold"
                              FontFamily="UnboundedBold"
                              Text="{TemplateBinding Title}"
                              TextColor="{AppThemeBinding Light=Black, Dark=White}"
                              />
                    </FormattedString>
                </Label.FormattedText>
            </Label>

            <Label AbsoluteLayout.LayoutBounds="1, 0.5, AutoSize, 1"
                AbsoluteLayout.LayoutFlags="PositionProportional, HeightProportional"
                TextColor="White"
                HorizontalTextAlignment="Center"
                VerticalTextAlignment="Center"
                Padding="0, 0, 10, 0">

                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="{TemplateBinding Extra1Text}"
                          TextColor="White"/>
                    </FormattedString>
                </Label.FormattedText>

                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{TemplateBinding Extra1Command}" />
                </Label.GestureRecognizers>
            </Label>
        </AbsoluteLayout>
    </ControlTemplate>
</ResourceDictionary>