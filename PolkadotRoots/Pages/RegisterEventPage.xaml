<?xml version="1.0" encoding="utf-8" ?>
<page:PageTemplate xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PolkadotRoots.Pages.RegisterEventPage"
             xmlns:form="clr-namespace:PlutoFramework.Components.Form;assembly=PlutoFramework"
             xmlns:page="clr-namespace:PlutoFramework.Templates.PageTemplate;assembly=PlutoFramework"
             xmlns:buttons="clr-namespace:PlutoFramework.Components.Buttons;assembly=PlutoFramework"
             Title="{Binding Title}">
    <ScrollView>
        <VerticalStackLayout Padding="18" Spacing="16">
            <Label Text="Organizers" FontSize="14" TextColor="{AppThemeBinding Light=#9ca3af, Dark=#d1d5db}" />
            <form:FormMultiAddressInputView Addresses="{Binding OrganisatorAddresses, Mode=TwoWay}" />

            <Label Text="Name" FontSize="14" TextColor="{AppThemeBinding Light=#9ca3af, Dark=#d1d5db}" />
            <form:FormInputView Placeholder="Event name" Text="{Binding Name}" />

            <form:FormImageUploadView Title="Event thumbnail image"
                                    ImageStream="{Binding ImageStream}" />

            <Label Text="Description" FontSize="14" TextColor="{AppThemeBinding Light=#9ca3af, Dark=#d1d5db}" />
            <form:FormLargeInputView x:Name="desc" Text="{Binding Description}" />

            <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                <Label Text="Virtual event" FontSize="14" TextColor="{AppThemeBinding Light=#9ca3af, Dark=#d1d5db}" VerticalOptions="Center" />
                <Switch IsToggled="{Binding IsVirtual}" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Label Text="Links" FontSize="14" TextColor="{AppThemeBinding Light=#9ca3af, Dark=#d1d5db}" />
            <form:FormInputView Placeholder="Website (optional)" Text="{Binding Website}" />
            <form:FormInputView Placeholder="Google Maps URL (optional)" Text="{Binding MapsUrl}" IsVisible="{Binding IsInPerson}" />
            <form:FormInputView Placeholder="Google Meets URL (optional)" Text="{Binding GoogleMeetsUrl}" IsVisible="{Binding IsVirtual}" />
            <form:FormInputView Placeholder="Zoom URL (optional)" Text="{Binding ZoomUrl}" IsVisible="{Binding IsVirtual}" />

            <Label Text="Location" FontSize="14" TextColor="{AppThemeBinding Light=#9ca3af, Dark=#d1d5db}" IsVisible="{Binding IsInPerson}" />
            <form:FormInputView Placeholder="Country" Text="{Binding Country}" IsVisible="{Binding IsInPerson}" />
            <form:FormInputView Placeholder="Address" Text="{Binding LocationAddress}" IsVisible="{Binding IsInPerson}" />

            <Label Text="Contacts" FontSize="14" TextColor="{AppThemeBinding Light=#9ca3af, Dark=#d1d5db}" />
            <form:FormInputView Placeholder="Phone number (optional)" Text="{Binding PhoneNumber}" />
            <form:FormInputView Placeholder="Email address (optional)" Text="{Binding EmailAddress}" />

            <Label Text="Details" FontSize="14" TextColor="{AppThemeBinding Light=#9ca3af, Dark=#d1d5db}" />
            <form:FormInputView Placeholder="Capacity (optional)" KeyboardType="Numeric" Text="{Binding CapacityText}" />
            <form:FormInputView Placeholder="Price (optional)" Text="{Binding Price}" />
            
            <Label Text="Note: If your event is not free, you will need to use your own way for collecting the entry fee. This app does not provide a way for attendees to buy tickets." 
                   FontSize="10"
                   Margin="5, 0, 0, 0"
                   TextColor="{AppThemeBinding Light=#9ca3af, Dark=#d1d5db}"/>

            <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                <Label Text="Supports DOT-back" FontSize="14" TextColor="{AppThemeBinding Light=#9ca3af, Dark=#d1d5db}" VerticalOptions="Center" />
                <Switch IsToggled="{Binding SupportsDotback}" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Label Text="Social media" FontSize="14" TextColor="{AppThemeBinding Light=#9ca3af, Dark=#d1d5db}" />
            <form:FormInputView Placeholder="Telegram (optional)" Text="{Binding Telegram}" />
            <form:FormInputView Placeholder="Discord (optional)" Text="{Binding Discord}" />
            <form:FormInputView Placeholder="X (optional)" Text="{Binding X}" />
            <form:FormInputView Placeholder="YouTube (optional)" Text="{Binding Youtube}" />
            <form:FormInputView Placeholder="Eventbrite (optional)" Text="{Binding Eventbrite}" />
            <form:FormInputView Placeholder="Luma (optional)" Text="{Binding LumaUrl}" />
            <form:FormInputView Placeholder="Imported from (optional)" Text="{Binding ImportedFrom}" />

            <form:FormDateInputView Title="Start date" Date="{Binding StartDate}" />
            <form:FormDateInputView Title="End date" Date="{Binding EndDate}" />

            <Label Text="You can always change and update the details of the event after submission." 
                   FontSize="10"
                   Margin="5, 0, 0, 0"
                   TextColor="{AppThemeBinding Light=#9ca3af, Dark=#d1d5db}"/>
            
            <buttons:ElevatedButton Text="Submit"
                                    ButtonState="{Binding SubmitButtonState}"
                                    Command="{Binding SubmitCommand}"/>
        </VerticalStackLayout>
    </ScrollView>
</page:PageTemplate>
